# Source files (not needed in published package)
src/
tests/
scripts/

# Documentation (keep README, LICENSE, CHANGELOG)
docs/
*.md
!README.md
!CHANGELOG.md

# Configuration files
tsconfig.json
tsup.config.ts
vitest.config.ts
.gitignore
.npmignore

# Development files
.vscode/
.idea/
*.log

# Test artifacts
test-reports/
coverage/

# Build artifacts that shouldn't be published
*.tsbuildinfo
.cache/

# Git
.git/
.gitattributes

# Generated test config
.claude/
